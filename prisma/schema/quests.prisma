// Quests (Admin creates these)
model Quest {
    id         String      @id @default(uuid())
    title      String
    category   String // HEALTH, FITNESS, MINDFULNESS, etc.
    xpReward   Int         @default(0)
    isDaily    Boolean     @default(false)
    userQuests UserQuest[]

    @@map("quests")
}

// User Quest Progress
model UserQuest {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    questId   String
    quest     Quest    @relation(fields: [questId], references: [id], onDelete: Cascade)
    completed Boolean  @default(false)
    date      DateTime @default(now()) @db.Date

    @@unique([userId, questId, date]) // A user can complete the same quest once per day
    @@index([userId])
    @@index([questId])
    @@map("user_quests")
}

// User Custom Quests
model CustomQuest {
    id              String    @id @default(uuid())
    userId          String
    user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    name            String
    category        String    // FITNESS, NUTRITION, MINDFULNESS, GENERAL
    description     String?
    scheduledDate   DateTime?
    scheduledTime   String?   // HH:mm
    recurrence      String    @default("NONE") // NONE, DAILY, WEEKLY, SPECIFIC_DAYS, CUSTOM
    daysOfWeek      Int[]     @default([])
    reminderEnabled Boolean   @default(false)
    reminderTime    String?
    isPaused        Boolean   @default(false)
    lastCompletedAt DateTime?
    xp              Int       @default(10)
    createdAt       DateTime  @default(now())
    updatedAt       DateTime  @updatedAt

    @@index([userId])
    @@map("custom_quests")
}

