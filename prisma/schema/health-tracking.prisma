// Weight Logs
model WeightLog {
    id       String   @id @default(uuid())
    userId   String
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    weight   String
    note     String?
    loggedAt DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("weight_logs")
}

// Mood Logs
model MoodLog {
    id          String       @id @default(uuid())
    userId      String
    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    mood        Mood
    energyLevel EnergyLevel?
    hungerLevel HungerLevel?
    note        String?
    loggedAt    DateTime     @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("mood_logs")
}

enum Mood {
    TIRED
    GOOD
    PISSED
    GREAT
    POOR
}

enum EnergyLevel {
    EXHAUSTED
    LOW
    MODERATE
    ENERGIZED
    HIGH
}

enum HungerLevel {
    NOT_HUNGRY
    HUNGRY
    VERY_HUNGRY
}

// Meal Schedules
model MealSchedule {
    id          String   @id @default(uuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mealType    String // BREAKFAST, LUNCH, DINNER, SNACK
    scheduledAt DateTime

    @@index([userId])
    @@index([scheduledAt])
    @@map("meal_schedules")
}

// Meal Logs
model MealLog {
    id          String   @id @default(uuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mealType    String // BREAKFAST, LUNCH, DINNER, SNACK
    description String?
    calories    Int?
    carbs       Int?
    protein     Int?
    fats        Int?
    loggedAt    DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("meal_logs")
}

// Medications
model Medication {
    id                  String               @id @default(uuid())
    userId              String
    user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
    name                String
    type                String? // PILL, INJECTION, LIQUID, etc.
    createdAt           DateTime             @default(now())
    medicationSchedules MedicationSchedule[]
    medicationLogs      MedicationLog[]

    @@index([userId])
    @@map("medications")
}

// Medication Schedules
model MedicationSchedule {
    id           String     @id @default(uuid())
    userId       String
    user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
    medicationId String
    medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
    doseMg       Decimal    @db.Decimal(10, 2) // e.g., 500.00 mg
    scheduleTime DateTime

    @@index([userId])
    @@index([medicationId])
    @@index([scheduleTime])
    @@map("medication_schedules")
}

// Medication Logs
model MedicationLog {
    id           String     @id @default(uuid())
    medicationId String
    medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
    doseMg       Decimal    @db.Decimal(10, 2) // e.g., 500.00 mg
    takenAt      DateTime   @default(now())

    @@index([medicationId])
    @@index([takenAt])
    @@map("medication_logs")
}

// Exercise Logs
model ExerciseLog {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      String // CARDIO, STRENGTH, FLEXIBILITY, etc.
    name      String // Running, Push-ups, Yoga, etc.
    intensity String? // LOW, MEDIUM, HIGH
    duration  Int? // in minutes
    note      String?
    loggedAt  DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("exercise_logs")
}
