// Weight Logs
model WeightLog {
    id       String   @id @default(uuid())
    userId   String
    user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    weight   String
    note     String?
    loggedAt DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("weight_logs")
}

// Mood Logs
model MoodLog {
    id          String       @id @default(uuid())
    userId      String
    user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    mood        Mood
    energyLevel EnergyLevel?
    hungerLevel HungerLevel?
    note        String?
    loggedAt    DateTime     @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("mood_logs")
}

enum Mood {
    TIRED
    GOOD
    PISSED
    GREAT
    POOR
}

enum EnergyLevel {
    EXHAUSTED
    LOW
    MODERATE
    ENERGIZED
    HIGH
}

enum HungerLevel {
    NOT_HUNGRY
    HUNGRY
    VERY_HUNGRY
}

// Meal Schedules
model MealSchedule {
    id          String   @id @default(uuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mealType    MealType // BREAKFAST, LUNCH, DINNER, SNACK
    scheduledAt DateTime
    calories    Int?
    carbs       Int?
    protein     Int?
    fats        Int?

    @@index([userId])
    @@index([scheduledAt])
    @@map("meal_schedules")
}

enum MealType {
    BREAKFAST
    LUNCH
    DINNER
    SNACK
}

// Meal Logs
model MealLog {
    id          String   @id @default(uuid())
    userId      String
    user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    mealType    MealType // BREAKFAST, LUNCH, DINNER, SNACK
    description String?
    calories    Int?
    carbs       Int?
    protein     Int?
    fats        Int?
    loggedAt    DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("meal_logs")
}

// Medications
model Medication {
    id        String          @id @default(uuid())
    userId    String
    user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    name      String
    type      MedicationType?
    doseMg    Int? // e.g., 500 mg
    createdAt DateTime        @default(now())

    @@index([userId])
    @@map("medications")
}

enum MedicationType {
    CAPSULE
    INJECTION
    LIQUID
    TABLET
}

// Medication Schedules
model MedicationSchedule {
    id           String          @id @default(uuid())
    userId       String
    user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    name         String
    type         MedicationType?
    doseMg       Int? // e.g., 500 mg
    scheduleTime DateTime

    @@index([userId])
    @@index([scheduleTime])
    @@map("medication_schedules")
}

// Exercise Logs
model ExerciseLog {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      exercise_type // CARDIO, STRENGTH, FLEXIBILITY, etc.
    name      String // Running, Push-ups, Yoga, etc.
    intensity exercise_intensity? // LOW, MEDIUM, HIGH
    duration  Int? // in minutes
    note      String?
    loggedAt  DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("exercise_logs")
}
model ExerciseScheduleLog {
    id        String   @id @default(uuid())
    userId    String
    user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    type      exercise_type // CARDIO, STRENGTH, FLEXIBILITY, etc.
    name      String // Running, Push-ups, Yoga, etc.
    intensity exercise_intensity? // LOW, MEDIUM, HIGH
    duration  Int? // in minutes
    note      String?
    loggedAt  DateTime @default(now())

    @@index([userId])
    @@index([loggedAt])
    @@map("exercise_schedule_logs")
}


enum exercise_type {
    CARDIO
    STRENGTH
    FLEXIBILITY
    BALANCE
}
enum exercise_intensity {
    MEDIUM
    LOW
    HIGH
}
