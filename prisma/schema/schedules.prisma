// Unified Recurring Schedules (Medications & Workouts)
enum ScheduleItemType {
    MEDICATION
    WORKOUT
    MEAL
    GENERAL
}

enum ScheduleRecurrenceType {
    NONE
    DAILY
    WEEKLY
    SPECIFIC_DAYS
}

model ScheduleItem {
    id             String                 @id @default(uuid())
    userId         String
    user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
    itemType       ScheduleItemType       @default(WORKOUT)
    title          String
    description    String?
    recurrenceType ScheduleRecurrenceType @default(NONE)
    daysOfWeek     Int[]                  @default([])
    timeOfDay      String?                // e.g., "08:30"
    isPaused       Boolean                @default(false)
    startDate      DateTime               @default(now()) @db.Date
    endDate        DateTime?              @db.Date
    metadata       Json?                  // Extra payload (e.g. doseMg, medicationType, exerciseType, intensity, duration)
    createdAt      DateTime               @default(now())
    updatedAt      DateTime               @updatedAt
    scheduleCompletionLogs ScheduleCompletionLog[]

    @@index([userId])
    @@index([userId, startDate])
    @@map("scheduled_items")
}

// Tracks daily completions for recurring scheduled items
model ScheduleCompletionLog {
    id             String       @id @default(uuid())
    scheduleItemId String
    scheduleItem   ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
    userId         String
    user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
    completedAt    DateTime     @default(now())

    @@index([userId])
    @@index([scheduleItemId])
    @@map("schedule_completion_logs")
}

// Tracks daily completions by local calendar date for recurring scheduled activities (workouts, medications, meals)
model ScheduleCompletion {
    id           String   @id @default(uuid())
    userId       String
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
    scheduleId   String   // ID of the master schedule (exercise_schedule_logs, medication_schedules, meal_schedules, or scheduled_items)
    scheduleType String   // 'WORKOUT', 'MEDICATION', 'MEAL', 'GENERAL'
    date         String   // 'YYYY-MM-DD' representing the user's local calendar date
    isCompleted  Boolean  @default(true)
    completedAt  DateTime @default(now())
    earnedXp     Int      @default(10)
    createdAt    DateTime @default(now())

    @@unique([userId, scheduleId, date])
    @@index([userId, date])
    @@index([scheduleId, date])
    @@map("schedule_completions")
}

