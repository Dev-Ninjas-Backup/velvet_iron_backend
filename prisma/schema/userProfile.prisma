model UserProfile {
    id                  String          @id @default(uuid())
    userId              String          @unique
    user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
    activeThemeId       String?
    activeTheme         Theme?          @relation("ActiveTheme", fields: [activeThemeId], references: [id])
    activeCompanionId   String?
    activeCompanion     Companion?      @relation("ActiveCompanion", fields: [activeCompanionId], references: [id])
    availableThemes     Theme[]         @relation("availabalethemes")
    availableCompanions String[]        @default([])
    themeCredits        Int             @default(0)
    companionCredits    Int             @default(0)
    totalEarnXp         Int             @default(0)
    balanceXp           Int             @default(0)
    level               Int             @default(1)
    onBoardingCompleted Boolean?        @default(false)
    fitnessGoal         String?
    dailyWaterGoal      Float           @default(64)
    waterUnit           WaterUnit       @default(OZ)
    dailyStepGoal       Int             @default(8000)
    calorieGoal         Float?
    calorieGoalMode     CalorieGoalMode @default(AUTO)
    lifetimeSteps       Int             @default(0)
    totalCampsites      Int             @default(0)
    createdAt           DateTime        @default(now())
    updatedAt           DateTime        @updatedAt
    availableComponions Companion[]     @relation("availableCompanions")

    @@index([userId])
    @@map("user_profiles")
}

enum CalorieGoalMode {
    AUTO
    MANUAL
}
